{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "app/api/queues/business-card/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "business-card-processing",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/queues/password-reset/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "password-reset-delivery",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/queues/agent-action/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "agent-action-execution",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/queues/maintenance/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "maintenance-heartbeat",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/queues/event-operations/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "event-operations",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
