{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "orbits",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "orbits-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "repos/orbits/scripts/verify-server.sh"
      ],
      "port": 3001
    },
    {
      "name": "designs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3320",
        "-d",
        "docs/designs"
      ],
      "port": 3320
    },
    {
      "name": "orbits-gate",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3005"
      ],
      "port": 3005,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-gate"
      }
    },
    {
      "name": "orbits-r26",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3026"
      ],
      "port": 3026,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-r26",
        "ORBIT_REDESIGN_MOCK": "event-assessment,plan-v2-summary"
      }
    },
    {
      "name": "orbits-r27",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3027"
      ],
      "port": 3027,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-r27",
        "ORBIT_REDESIGN_MOCK": "event-assessment,plan-v2-summary,event-recommendation-feedback"
      }
    },
    {
      "name": "orbits-r17",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3017"
      ],
      "port": 3017,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-r17",
        "ORBIT_REDESIGN_MOCK": "event-assessment,plan-v2-summary,event-recommendation-feedback,host-operations"
      }
    },
    {
      "name": "orbits-r30",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3030"
      ],
      "port": 3030,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-r30",
        "ORBIT_REDESIGN_MOCK": "global-search"
      }
    },
    {
      "name": "orbits-add-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "repos/orbits",
        "--",
        "--port",
        "3207"
      ],
      "port": 3207,
      "env": {
        "ORBIT_NEXT_DIST_DIR": ".next-r207",
        "ORBIT_REDESIGN_MOCK": "add-scan,add-import,invite-codes"
